# 元枢本体 — 环境变量配置模板
# 复制为 .env 并填入真实值后启动

# ===== 必填 =====
SECRET_KEY=your-secret-key-at-least-32-chars

# ===== 数据库 =====
DATABASE_URL=sqlite:///./ontology.db
REDIS_URL=redis://localhost:6379/0

# ===== Neo4j 图数据库 =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ===== 外部存储 =====
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=milvus

# ===== LLM =====
LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5-plus

# ===== 安全 =====
CORS_ORIGINS=http://localhost:5177,http://127.0.0.1:5177
# Required on first initialization; upper/lower/digit, minimum 8 characters.
# Existing administrator passwords are never reset by startup configuration.
ADMIN_INITIAL_PASSWORD=
CREDENTIAL_ENCRYPTION_KEY=

# ===== 运行 =====
HOST=0.0.0.0
PORT=8001
DEBUG=false
MONITOR_ENABLED=true
DATA_PLANE_REFRESH_ENABLED=true
# Workspace and local SQLite sources default to repository/workspace, repository/local-data.
# WORKSPACE_ROOT=/absolute/path/to/workspace
# Optional for legacy .doc/.xls/.ppt ingestion; default searches PATH for soffice.
# OFFICE_CONVERTER=/absolute/path/to/soffice
# OFFICE_CONVERSION_TIMEOUT_SECONDS=45
# LOCAL_DATA_ROOT=/absolute/path/to/isolated-data
CODE_SERVER_PORT=8443
CODE_SERVER_BIND_HOST=127.0.0.1
# CODE_SERVER_PASSWORD=choose-a-strong-password
MCP_REQUIRE_AUTH=true
